featurePrefixes = (
{
code = "###
# OpenType Layout feature definitions
# Format: Adobe FDK for OpenType (AFDKO) version 2.5
# Generated on: 2026-8-7 18:11
# Generated by: FontLab 8.0.0
# Font PostScript name: DINish
# Font copyright: Copyright 2021-2024 The DINish Project Authors (https://github.com/playbeing/dinish)
#
# Totals:
# Languagesystems: 8
# GSUB lookups: 44
# GSUB features: 16 (ccmp, dlig, dnom, frac, liga, lnum, locl, numr, onum, ordn, pnum, rtla, ss01, ss02, sups, tnum)
# GPOS lookups: 5
# GPOS features: 2 (kern, onum)

#
# Languagesystem definitions
#

languagesystem DFLT dflt; # Default default
languagesystem latn dflt; # Latin default
languagesystem latn MOL ; # Latin Moldavian
languagesystem latn NLD ; # Latin Dutch
languagesystem latn PLK ; # Latin Polish
languagesystem latn ROM ; # Latin Romanian
languagesystem cyrl dflt; # Cyrillic default
languagesystem cyrl BGR ; # Cyrillic Bulgarian

#
# Lookup definitions
#


#
# Feature definitions
#
";
tag = Languagesystems;
}
);
features = (
{
code = "# GSUB feature: Right-to-left alternates
# Lookups: 1

  sub @rtla by @rtla2;";
tag = rtla;
},
{
code = "# GSUB feature: Superscript
# Lookups: 1

  sub @dnom_frac_numr_ordn_sups by @sups;";
tag = sups;
},
{
code = "# GSUB feature: Ordinals
# Lookups: 1

  sub @dnom_frac_numr_ordn_sups [A a]' by [ordfeminine ordfeminine];
  sub @dnom_frac_numr_ordn_sups [O o]' by [ordmasculine ordmasculine];";
tag = ordn;
},
{
code = "# GSUB feature: Discretionary Ligatures
# Lookups: 1

  script latn; # Latin
  sub t t by t_t;";
tag = dlig;
},
{
code = "# GSUB feature: Standard Ligatures
# Lookups: 1

  script latn; # Latin
  sub f i by fi;
  sub f l by fl;";
tag = liga;
},
{
